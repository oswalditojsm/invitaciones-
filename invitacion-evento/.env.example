# Datos de tu base de datos Turso
# Obtén estos valores con: turso db show <nombre-db> --url
#                     y:    turso db tokens create <nombre-db>
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui

# Clave para entrar al panel de administrador (elige una tú mismo)
ADMIN_KEY=elige-una-clave-secreta

# Puerto local (Render la asigna automáticamente en producción)
PORT=3000
